POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tecdia_tray_track
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
AUTH_SESSION_SECRET=replace_with_a_long_random_secret

# Exactly 6 digits. Checked only on the server.
ADMIN_PIN=123456

# Cashier PIN for portion adjustments on the kiosk (admin PIN also works).
CASHIER_PIN=654321

# Optional: override only if the frontend should call a remote API instead of Next.js routes.
NEXT_PUBLIC_API_URL=/api
