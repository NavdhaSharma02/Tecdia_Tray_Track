POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tecdia_tray_track
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
AUTH_SESSION_SECRET=replace_with_a_long_random_secret

# Exactly 6 digits. Checked only on the server.
ADMIN_PIN=123456

# Cashier PIN for portion adjustments on the kiosk (admin PIN also works).
CASHIER_PIN=654321

# Optional: override only if the frontend should call a remote API instead of Next.js routes.
NEXT_PUBLIC_API_URL=/api

# Vision: clip = production | simulate = dev only (random items, no ML)
ML_INFERENCE_MODE=clip
ML_MODEL_ID=Xenova/clip-vit-base-patch32
ML_MODEL_CACHE_DIR=./data/ml-cache
MENU_IMAGES_DIR=./data/menu-images
# Required for tray scan: dish localization (auto-started when missing, or npm run dev:ml)
ML_YOLO_SERVICE_URL=http://127.0.0.1:5001/detect
# ML_YOLO_AUTO_START=true
# ML_YOLO_PYTHON=python
# ML_YOLO_TIMEOUT_MS=30000
# ML_YOLO_STARTUP_TIMEOUT_MS=300000
# Defaults to ../Dish Localization/best.pt (rice_big, rice_small, food, soup, …)
# ML_YOLO_MODEL_PATH=../Dish Localization/best.pt

# Offline training bank (image_embeddings.npy, text_embeddings.npy, label_map.json).
# Defaults to ../Computer Vision relative to the app root. Set to "off" to disable sync.
# ML_VISION_BANK_DIR=../Computer Vision
